# Poof runs one company/product per deployment.
POOF_ENV=development
POOF_COMPANY_NAME=Poof
POOF_TAGLINE=Share an idea, report a problem, or vote for what matters.
POOF_PUBLIC_URL=http://localhost:8080

# PostgreSQL 13 or newer. sslmode=disable is suitable only for local/private use.
DATABASE_URL=postgresql://poof:poof@127.0.0.1:5432/poof?sslmode=disable
POOF_DATABASE_POOL_SIZE=8

# Create an application at https://discord.com/developers/applications.
DISCORD_CLIENT_ID=replace-with-discord-client-id
DISCORD_CLIENT_SECRET=replace-with-discord-client-secret
DISCORD_REDIRECT_URI=http://localhost:8080/auth/discord/callback

# Comma-separated Discord snowflakes. At least one is required in production.
POOF_ADMIN_DISCORD_IDS=123456789012345678

# Independent 32-byte keys encoded as 64 hexadecimal characters.
# Generate each with: openssl rand -hex 32
POOF_CSRF_KEY=replace-with-64-hex-characters
POOF_API_TOKEN_PEPPER=replace-with-different-64-hex-characters

POOF_LISTEN_PORT=8080
POOF_WORKERS=4
POOF_SESSION_TTL_DAYS=30
