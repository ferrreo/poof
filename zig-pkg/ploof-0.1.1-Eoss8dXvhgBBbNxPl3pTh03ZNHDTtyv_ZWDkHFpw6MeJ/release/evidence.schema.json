{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ferrreo/ploof/release/evidence.schema.json",
  "title": "Ploof release gate evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gate_id",
    "revision",
    "result",
    "started_at",
    "finished_at",
    "command",
    "runner",
    "gate_manifest_sha256",
    "support_matrix_sha256",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "gate_id": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "result": {"const": "pass"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "architecture",
        "kernel",
        "cpu_vendor",
        "cpu_model",
        "cpu_flags",
        "microcode",
        "machine_id_sha256",
        "zig"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "kernel": {"type": "string", "minLength": 1},
        "cpu_vendor": {"type": "string", "minLength": 1},
        "cpu_model": {"type": "string", "minLength": 1},
        "cpu_flags": {"type": "string"},
        "microcode": {"type": "string", "minLength": 1},
        "machine_id_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "zig": {"type": "string", "minLength": 1}
      }
    },
    "gate_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "support_matrix_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
