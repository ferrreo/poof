{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ferrreo/ploof/release/release-notes.schema.json",
  "title": "Ploof reviewed release-note prose",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version",
    "changes",
    "migration",
    "security",
    "performance"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 600}
    },
    "migration": {"type": "string", "minLength": 1, "maxLength": 600},
    "security": {"type": "string", "minLength": 1, "maxLength": 600},
    "performance": {"type": "string", "minLength": 1, "maxLength": 600}
  }
}
