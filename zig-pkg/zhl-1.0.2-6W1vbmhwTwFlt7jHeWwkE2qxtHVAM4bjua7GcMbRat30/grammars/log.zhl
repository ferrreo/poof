grammar "text.log" {
    name "Log";
    scope root = "text.log";

    context main {
        string "\"" escape "\\" scope "string.quoted.double.log";
        string "'" escape "\\" scope "string.quoted.single.log";
        number generic scope "constant.language.log";
        keywords "TRACE Trace trace DEBUG Debug debug" scope "comment.log";
        keywords "HINT INFO INFORMATION Info NOTICE Started" scope "keyword.log";
        keywords "WARNING WARN Warning Warn" scope "keyword.log";
        keywords "ALERT CRITICAL EMERGENCY ERROR FAILURE FAIL Fatal FATAL Error Failed" scope "string.log";
        keywords "true false null" scope "constant.language.log";
    }
}
