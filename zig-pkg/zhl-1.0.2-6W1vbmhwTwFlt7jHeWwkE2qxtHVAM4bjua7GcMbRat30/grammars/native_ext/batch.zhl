grammar "source.batchfile" {
    name "batch";
    scope root = "source.batchfile";
    context main {
        line_comment "@rem" scope "comment.line.batchfile";
        line_comment "rem" scope "comment.line.batchfile";
        line_comment "::" scope "comment.line.batchfile";
        string "\"" escape "^" scope "string.quoted.double.batchfile";
        number generic scope "constant.numeric.batchfile";
        prefix_identifier "%" scope "variable.other.batchfile";
        keywords "if else for in do goto call exit set setlocal endlocal defined exist equ neq lss leq gtr geq errorlevel shift start title color pause" scope "keyword.control.batchfile";
        keywords "echo cd chdir copy del erase move mkdir md rmdir rd type find findstr where path pushd popd" scope "support.function.builtin.batchfile";
        operators "== != >= <= && || > >> < 2> 2>&1 & | ^ = ( )" scope "keyword.operator.batchfile";
    }
}
