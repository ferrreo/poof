grammar "source.coffee" {
    name "CoffeeScript";
    scope root = "source.coffee";
    context main {
        line_comment "#" scope "comment.line.number-sign.coffee";
        block_comment "###" "###" scope "comment.block.coffee";
        string "\"" escape "\\" scope "string.quoted.double.coffee";
        string "'" escape "\\" scope "string.quoted.single.coffee";
        number generic scope "constant.numeric.coffee";
        keywords "and break by catch class continue delete do else extends false finally for from if import in instanceof is isnt loop new no not null of off on or return super switch then this throw true try typeof unless until when while yes yield" scope "keyword.control.coffee";
        capitalized_identifier scope "entity.name.type.coffee";
        function_call scope "entity.name.function.coffee";
        operators "-> => ... .. == != <= >= && || += -= *= /= %= **= ?= ||= &&=" scope "keyword.operator.coffee";
        operators "+ - * / % = < > & | ^ ~ ! ? : ; , . { } ( ) [ ]" scope "keyword.operator.coffee";
    }
}
