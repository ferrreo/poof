grammar "source.commonlisp" {
    name "common-lisp";
    scope root = "source.commonlisp";

    context main {
        line_comment ";" scope "comment.line.semicolon.commonlisp";
        block_comment "#|" "|#" nested scope "comment.block.commonlisp";
        string "\"" escape "\\" scope "string.quoted.double.commonlisp";
        number generic scope "constant.numeric.commonlisp";
        keywords "and block catch cond declare defconstant defgeneric define-compiler-macro define-condition define-method-combination" scope "keyword.control.commonlisp";
        keywords "define-modify-macro define-setf-expander define-symbol-macro defmacro defmethod defpackage defparameter defsetf defstruct deftype" scope "keyword.control.commonlisp";
        keywords "defun defvar do do* dolist dotimes ecase etypecase eval-when flet function go handler-bind handler-case if labels lambda let let*" scope "keyword.control.commonlisp";
        keywords "locally loop macrolet multiple-value-bind multiple-value-call multiple-value-prog1 progn progv quote restart-bind restart-case return-from" scope "keyword.control.commonlisp";
        keywords "setq symbol-macrolet tagbody the throw typecase unless unwind-protect when nil t" scope "keyword.control.commonlisp";
        identifier_after "(" scope "entity.name.function.commonlisp";
        operators "#' #'( ,@ , ` ' # : :: + - * / = < > <= >= /=" scope "keyword.operator.commonlisp";
        operators "( ) [ ] { }" scope "punctuation.separator.commonlisp";
    }
}
