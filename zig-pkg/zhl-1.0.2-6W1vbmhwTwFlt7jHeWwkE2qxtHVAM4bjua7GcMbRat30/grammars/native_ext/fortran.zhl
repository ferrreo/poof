grammar "source.fortran" {
    name "fortran-fixed-form";
    scope root = "source.fortran";
    context main {
        line_comment "!" scope "comment.line.exclamation.fortran";
        string "\"" escape "\"\"" scope "string.quoted.double.fortran";
        string "'" escape "''" scope "string.quoted.single.fortran";
        number generic scope "constant.numeric.fortran";
        keywords "ALLOCATE ASSIGN BACKSPACE BLOCK CALL CASE CLOSE COMMON CONTAINS CONTINUE CYCLE DATA DEALLOCATE DEFAULT DO ELSE ELSEIF END ENDIF ENTRY EQUIVALENCE EXIT EXTERNAL FORMAT FUNCTION GO GOTO IF IMPLICIT INQUIRE INTERFACE INTENT MODULE NAMELIST NONE NULLIFY ONLY OPEN OPERATOR OPTIONAL PARAMETER PAUSE POINTER PRIVATE PROCEDURE PROGRAM PUBLIC READ RECURSIVE RESULT RETURN REWIND SAVE SELECT SEQUENCE STOP SUBROUTINE TARGET THEN USE WHERE WHILE WRITE" scope "keyword.control.fortran";
        keywords "allocate assign backspace block call case close common contains continue cycle data deallocate default do else elseif end endif entry equivalence exit external format function go goto if implicit inquire interface intent module namelist none nullify only open operator optional parameter pause pointer private procedure program public read recursive result return rewind save select sequence stop subroutine target then use where while write" scope "keyword.control.fortran";
        keywords "INTEGER REAL DOUBLE PRECISION COMPLEX LOGICAL CHARACTER TYPE integer real double precision complex logical character type" scope "support.type.primitive.fortran";
        function_call scope "entity.name.function.fortran";
        operators "** // == /= <= >= => + - * / = < > : ; , . ( )" scope "keyword.operator.fortran";
    }
}
