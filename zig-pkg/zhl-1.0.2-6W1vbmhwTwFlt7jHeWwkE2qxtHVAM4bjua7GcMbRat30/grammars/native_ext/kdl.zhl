grammar "source.kdl" {
    name "kdl";
    scope root = "source.kdl";
    context main {
        line_comment "//" scope "comment.line.double-slash.kdl";
        block_comment "/*" "*/" nested scope "comment.block.kdl";
        string "\"" escape "\\" scope "string.quoted.double.kdl";
        number generic scope "constant.numeric.kdl";
        keywords "true false null #true #false #null" scope "constant.language.kdl";
        identifier_before "=" scope "variable.other.field.kdl";
        capitalized_identifier scope "entity.name.type.kdl";
        operators "= ; { } ( ) [ ]" scope "punctuation.separator.kdl";
    }
}
