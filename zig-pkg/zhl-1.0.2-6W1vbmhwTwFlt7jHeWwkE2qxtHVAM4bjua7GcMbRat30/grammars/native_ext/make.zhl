grammar "source.makefile" {
    name "make";
    scope root = "source.makefile";

    context main {
        line_comment "#" scope "comment.line.number-sign.makefile";
        string "\"" escape "\\" scope "string.quoted.double.makefile";
        string "'" escape "\\" scope "string.quoted.single.makefile";
        number generic scope "constant.numeric.makefile";
        identifier_before "=" scope "variable.other.field.makefile";
        prefix_identifier "$" scope "variable.other.makefile";
        keywords "define endef undefine ifdef ifndef ifeq ifneq else endif include -include sinclude override export unexport private vpath" scope "keyword.control.makefile";
        keywords "subst patsubst strip findstring filter filter-out sort word wordlist words firstword lastword dir notdir suffix basename addsuffix" scope "support.function.builtin.makefile";
        keywords "addprefix join wildcard realpath abspath error warning info origin flavor foreach if or and call value eval file shell guile let" scope "support.function.builtin.makefile";
        operators ":: := ::= ?= += != <= >= == && ||" scope "keyword.operator.makefile";
        operators "+ - * / % = < > & | ^ ~ ! ? : ; , . @ { } ( ) [ ]" scope "keyword.operator.makefile";
    }
}
