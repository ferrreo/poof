grammar "markdown.mermaid.codeblock" {
    name "mermaid";
    scope root = "markdown.mermaid.codeblock";

    context main {
        line_comment "%%" scope "comment.line.percentage.mermaid";
        string "\"" escape "\\" scope "string.quoted.double.mermaid";
        string "'" escape "\\" scope "string.quoted.single.mermaid";
        number generic scope "constant.numeric.mermaid";
        keywords "graph flowchart sequenceDiagram classDiagram stateDiagram stateDiagram-v2 erDiagram journey gantt pie quadrantChart requirementDiagram" scope "keyword.control.mermaid";
        keywords "gitGraph mindmap timeline block-beta architecture-beta packet-beta kanban xychart-beta sankey-beta C4Context C4Container" scope "keyword.control.mermaid";
        keywords "C4Component C4Dynamic C4Deployment TD TB BT RL LR subgraph end participant actor activate deactivate loop alt opt par and rect note" scope "keyword.control.mermaid";
        keywords "title section autonumber critical break classDef class style linkStyle click direction dateFormat axisFormat todayMarker" scope "keyword.control.mermaid";
        prefix_identifier "$" scope "variable.other.mermaid";
        capitalized_identifier scope "entity.name.type.mermaid";
        function_call scope "entity.name.function.mermaid";
        operators "--> --- -.-> ==> -->> ->> -x --x -) --) <--> <==>" scope "keyword.operator.mermaid";
        operators "= : ; , . { } ( ) [ ] | &" scope "punctuation.separator.mermaid";
    }
}
