grammar "source.ocaml" {
    name "ocaml";
    scope root = "source.ocaml";

    context main {
        block_comment "(*" "*)" nested scope "comment.block.ocaml";
        string "\"" escape "\\" scope "string.quoted.double.ocaml";
        number generic scope "constant.numeric.ocaml";
        keywords "and as assert begin class constraint do done downto else end exception external false for fun function" scope "keyword.control.ocaml";
        keywords "functor if in include inherit initializer lazy let match method module mutable new nonrec object of open" scope "keyword.control.ocaml";
        keywords "or private rec sig struct then to true try type val virtual when while with" scope "keyword.control.ocaml";
        keywords "int float bool char string bytes list array unit exn option result" scope "support.type.primitive.ocaml";
        capitalized_identifier scope "entity.name.type.ocaml";
        function_call scope "entity.name.function.ocaml";
        operators "-> <- := :: ;; && || <= >= <> == != +. -. *. /. **" scope "keyword.operator.ocaml";
        operators "+ - * / % = < > & | ^ ~ ? : ; , . { } ( ) [ ]" scope "keyword.operator.ocaml";
    }
}
