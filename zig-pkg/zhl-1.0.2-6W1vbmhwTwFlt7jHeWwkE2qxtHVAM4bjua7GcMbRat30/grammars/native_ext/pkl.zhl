grammar "source.pkl" {
    name "pkl";
    scope root = "source.pkl";

    context main {
        line_comment "//" scope "comment.line.double-slash.pkl";
        block_comment "/*" "*/" nested scope "comment.block.pkl";
        string "\"" escape "\\" scope "string.quoted.double.pkl";
        number generic scope "constant.numeric.pkl";
        keywords "abstract amend amends as class const else extends external false fixed for function hidden if import import* in is let" scope "keyword.control.pkl";
        keywords "local module new nothing null open out outer read read? read* super this throw trace true typealias unknown when" scope "keyword.control.pkl";
        keywords "Any Boolean DataSize Duration Dynamic Float Int List Listing Map Mapping Number Pair Set String UInt Regex" scope "support.type.primitive.pkl";
        capitalized_identifier scope "entity.name.type.pkl";
        function_call scope "entity.name.function.pkl";
        operators "!! ?? ?. ** && || <= >= == != -> |>" scope "keyword.operator.pkl";
        operators "+ - * / % = < > & | ^ ~ ! ? : ; , . { } ( ) [ ]" scope "keyword.operator.pkl";
    }
}
