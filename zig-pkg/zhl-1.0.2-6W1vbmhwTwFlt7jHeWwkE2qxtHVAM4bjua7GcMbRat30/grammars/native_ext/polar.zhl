grammar "source.polar" {
    name "polar";
    scope root = "source.polar";
    context main {
        line_comment "#" scope "comment.line.number-sign.polar";
        string "\"" escape "\\" scope "string.quoted.double.polar";
        string "'" escape "\\" scope "string.quoted.single.polar";
        number generic scope "constant.numeric.polar";
        keywords "actor resource permissions roles relations if on and or not in matches true false nil" scope "keyword.control.polar";
        capitalized_identifier scope "entity.name.type.polar";
        function_call scope "entity.name.function.polar";
        identifier_before ":" scope "variable.other.field.polar";
        operators "== != <= >= = < > + - * / % : ; , . { } ( ) [ ]" scope "keyword.operator.polar";
    }
}
