grammar "source.splunk_search" {
    name "splunk";
    scope root = "source.splunk_search";

    context main {
        block_comment "```" "```" scope "comment.block.splunk_search";
        block_comment "`comment(" ")`" scope "comment.block.splunk_search";
        string "\"" escape "\\" scope "string.quoted.double.splunk_search";
        string "'" escape "\\" scope "string.quoted.single.splunk_search";
        number generic scope "constant.numeric.splunk_search";
        keywords "search where table fields rename eval stats eventstats streamstats chart timechart top rare sort dedup head tail" scope "keyword.control.splunk_search";
        keywords "transaction rex regex lookup inputlookup outputlookup join append appendcols map multisearch union makeresults gentimes" scope "keyword.control.splunk_search";
        keywords "bin bucket convert fillnull mvexpand nomv makemv spath xpath xmlkv kv erex predict trendline collect" scope "keyword.control.splunk_search";
        keywords "by as over span limit useother usenull count sum avg min max values dc earliest latest" scope "support.function.builtin.splunk_search";
        function_call scope "entity.name.function.splunk_search";
        operators ">= <= == != = > < + - * / % | &" scope "keyword.operator.splunk_search";
        operators "( ) [ ] { } , ." scope "punctuation.separator.splunk_search";
    }
}
