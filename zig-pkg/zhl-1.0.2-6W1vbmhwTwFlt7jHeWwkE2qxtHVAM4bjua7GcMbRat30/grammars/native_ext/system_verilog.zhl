grammar "source.systemverilog" {
    name "system-verilog";
    scope root = "source.systemverilog";

    context main {
        line_comment "//" scope "comment.line.double-slash.systemverilog";
        block_comment "/*" "*/" scope "comment.block.systemverilog";
        string "\"" escape "\\" scope "string.quoted.double.systemverilog";
        number generic scope "constant.numeric.systemverilog";
        builtin_prefix "$" scope "support.function.builtin.systemverilog";
        prefix_identifier "`" scope "keyword.control.directive.systemverilog";
        keywords "always always_comb always_ff always_latch assign automatic begin bind bins binsof bit break byte case casex casez" scope "keyword.control.systemverilog";
        keywords "cell chandle checker class clocking config const constraint context continue cover covergroup coverpoint cross deassign default" scope "keyword.control.systemverilog";
        keywords "defparam design disable dist do edge else end endcase endchecker endclass endclocking endconfig endfunction endgenerate endgroup" scope "keyword.control.systemverilog";
        keywords "endinterface endmodule endpackage endprimitive endprogram endproperty endspecify endsequence endtable endtask enum event expect export extends" scope "keyword.control.systemverilog";
        keywords "extern final first_match for force foreach forever fork forkjoin function generate genvar global highz0 highz1 if iff ifnone" scope "keyword.control.systemverilog";
        keywords "implements implies import incdir include initial inout input inside int integer interconnect interface intersect join join_any" scope "keyword.control.systemverilog";
        keywords "join_none large let liblist library local localparam logic longint macromodule matches medium modport module nand negedge nettype new" scope "keyword.control.systemverilog";
        keywords "nmos nor noshowcancelled not notif0 notif1 null or output package packed parameter pmos posedge primitive priority program property" scope "keyword.control.systemverilog";
        keywords "protected pull0 pull1 pulldown pullup pure rand randc randcase randsequence rcmos real realtime ref reg release repeat restrict" scope "keyword.control.systemverilog";
        keywords "return rnmos rpmos rtran rtranif0 rtranif1 scalared sequence shortint shortreal showcancelled signed small solve specify specparam" scope "keyword.control.systemverilog";
        keywords "static string strong strong0 strong1 struct super supply0 supply1 sync_accept_on sync_reject_on table tagged task this throughout" scope "keyword.control.systemverilog";
        keywords "time timeprecision timeunit tran tranif0 tranif1 tri tri0 tri1 triand trior trireg type typedef union unique unique0 unsigned" scope "keyword.control.systemverilog";
        keywords "use uwire var vectored virtual void wait wait_order wand weak weak0 weak1 while wildcard wire with within wor xnor xor" scope "keyword.control.systemverilog";
        capitalized_identifier scope "entity.name.type.systemverilog";
        function_call scope "entity.name.function.systemverilog";
        operators "=== !== ==? !=? >>> <<< >> << <= >= == != && || ++ -- += -= *= /= %= &= |= ^= -> => |-> |=> ##" scope "keyword.operator.systemverilog";
        operators "+ - * / % = < > & | ^ ~ ! ? : ; , . # @ { } ( ) [ ]" scope "keyword.operator.systemverilog";
    }
}
