grammar "source.systemd" {
    name "systemd";
    scope root = "source.systemd";
    context main {
        line_comment "#" scope "comment.line.number-sign.systemd";
        line_comment ";" scope "comment.line.semicolon.systemd";
        string "\"" escape "\\" scope "string.quoted.double.systemd";
        string "'" escape "\\" scope "string.quoted.single.systemd";
        number generic scope "constant.numeric.systemd";
        identifier_before "=" scope "variable.other.field.systemd";
        keywords "true false yes no on off" scope "constant.language.systemd";
        operators "[ ] =" scope "punctuation.separator.systemd";
    }
}
